# Copy to .env (repo root or backend/) and fill in. Never commit .env.

# --- API keys ---------------------------------------------------------------
GEMINI_API_KEY=          # required — https://aistudio.google.com/apikey
TAVILY_API_KEY=          # required — https://app.tavily.com (free plan: 1,000 credits/month)
YOUTUBE_API_KEY=         # optional — Google Cloud key with "YouTube Data API v3" enabled; without it the YouTube step warns
GOOGLE_BOOKS_API_KEY=    # optional — works keyless at a lower quota; Open Library is the fallback

# --- Models -------------------------------------------------------------------
# Check current ids at https://aistudio.google.com/docs/models and your free-tier
# limits at https://aistudio.google.com/rate-limit. As of Nov 2026 these were stable:
#   gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite
# Use a different model for QC than for generation (independent judge).
GEN_MODEL=gemini-3.6-flash
QC_MODEL=gemini-3.5-flash-lite

# --- Modes --------------------------------------------------------------------
# 1 = use fake providers (no network, no keys). Output is clearly marked [FAKE].
DEMO_OFFLINE=0

# --- Optional overrides -----------------------------------------------------------
# DATABASE_URL=sqlite:///./data/lessons.db
# READING_WPM=200
# LESSON_MINUTES_BUDGET=45
# YOUTUBE_MAX_SEARCHES=1

# --- Model fallback chain (tried in order after GEN_MODEL / QC_MODEL) -------------
# On 429 / 503 / 504 / timeout / daily quota the next model answers immediately (no backoff loop).
# Verified working on 2026-11-07 with scripts/check_models.py: gemini-3.5-flash-lite, gemini-3.1-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_TIMEOUT_S=120

# --- Groq: last resort after every Gemini model fails (OpenAI-compatible API) ---------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # verified 2026-11-07 with a "say ok" call; see https://api.groq.com/openai/v1/models
